# ==============================================================================
# CLOUDMED AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Backend Node.js Server
PORT=5000
NODE_ENV=development

# Cloud Database: MongoDB Atlas
# (Defaults to local mongodb://127.0.0.1:27017/cloudmed_ai if unpopulated)
MONGO_URI=mongodb://127.0.0.1:27017/cloudmed_ai
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cloudmed_ai?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=cloudmed_ai_production_jwt_secret_key_2026_super_secure
JWT_EXPIRE=7d

# Cloud Document Storage: Cloudinary (Optional - falls back to local storage if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Microservices Network Routing
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_PORT=8000

# Client Configuration
VITE_API_URL=http://localhost:5000/api

# Demo Administration Account
ADMIN_EMAIL=admin@cloudmed.demo
ADMIN_PASSWORD=Admin@1234
